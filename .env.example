# TailorCV — local environment
# Copy to `.env` (gitignored) and adjust.

# Opt-in browser mock (localStorage). Leave false to use the FastAPI backend.
NEXT_PUBLIC_USE_MOCK=false

# Where the browser reaches the Python API (host-published :8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Allowed CORS origins for the backend (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Prefill demo applications on first backend boot (SQLite volume). Off by default.
SEED_DEMO=0
